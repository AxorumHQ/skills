; Generated: do not edit this file.
;
; The Axorum policy language: its syntax as an ABNF grammar (RFC 5234).
;
; It uses RFC 7405: %s"..." matches case-sensitively. Every keyword is
; written %s"..."; a plain "..." string holds only punctuation, which has no
; case. No RFC 5234 core rule is used: every rule named here is defined
; here. The start rule is `document`.
;
; Whitespace and comments
; -----------------------
; `ws` (optional) and `sep` (required) are runs of blanks and `//` line
; comments. One of them stands between every two adjacent tokens: `sep`
; where both tokens are words, `ws` everywhere else. A word is a keyword, a
; name, an integer or an id: a run of [a-z0-9_] that only a blank or a
; comment can end before another word. A currency code is not a word (it is
; uppercase), and punctuation, operators and strings end themselves, so
; `role r}` and `posted USD in` need no more than `ws`.
;
; A construct that can end either with a word or with something else has
; two forms, so the gap after it can be right: a rule name ending in `-w`
; ends with a word; one ending in `-p` ends with punctuation, a string or a
; currency code.
;
; What the grammar leaves to prose
; --------------------------------
; - Integer ranges. An integer's underscores are dropped before it is read.
;   A tick, a duration and a window bound fit an unsigned 64-bit integer;
;   `int(...)` fits a signed 64-bit integer; an amount's minor units fit a
;   signed 128-bit integer; a priority fits a signed 32-bit integer.
; - Uniqueness. The names a policy declares are unique within each kind
;   (role, action, party, delegation, rule, aggregate), and so are an
;   action's parameter names, an action term's keys, a capture's targets and
;   the names of a rule's `unless` clauses. A party's roles and a
;   delegation's actions and roles are sets: a member written twice counts
;   once.
; - Clause counts. A rule's `trigger`, `when`, `on_violation` and temporal
;   clause (`within`, `by` or `during`) come at most once each, though
;   `clause-run` below lets them repeat.
; - Meaning. Which names must be declared, which types and currencies must
;   agree, and every other well-formedness check apply to a source this
;   grammar accepts.

document          = ws policy-block ws [end-comment]

policy-block      = %s"policy" ws "{" ws *(item-w sep / item-p ws) [item-w ws] "}"

item-w            = role-decl / party-decl-w / aggregate-decl-w
item-p            = action-decl / party-decl-p / delegation-decl / aggregate-decl-p
                  / rule-decl

; --- roles, actions, parties, delegations ------------------------------------

role-decl         = %s"role" sep name

action-decl       = %s"action" sep name ws "(" ws [param-decl *(ws "," ws param-decl) ws] ")"
param-decl        = name ws ":" ws value-type

party-decl-w      = %s"party" sep name sep party-kind
party-decl-p      = party-decl-w sep %s"roles" ws name-list
party-kind        = %s"principal" / %s"agent"

delegation-decl   = %s"delegation" sep name ws "{" ws
                    %s"principal" sep name sep %s"agent" sep name sep
                    %s"scope" ws "{" ws
                    %s"actions" ws name-list ws %s"roles" ws name-list ws
                    [%s"window" ws "(" ws int-literal ws "," ws int-literal ws ")" ws]
                    "}" ws "}"

name-list         = "(" ws [name *(ws "," ws name) ws] ")"

; --- aggregates --------------------------------------------------------------

; A count or a parameter sum may name its currency after the window; a sum of
; postings takes its currency from the posting selector instead.
aggregate-decl-w  = %s"aggregate" sep name sep (counted / summed / posting-sum)
aggregate-decl-p  = %s"aggregate" sep name sep (counted / summed) sep %s"in" ws currency

counted           = %s"counts" sep name sep scope-and-window
summed            = %s"sums" sep name ws "(" ws name ws ")" ws scope-and-window
; After a selector with no account, `in` would start an account, so the
; action summed over cannot be named `in` there.
posting-sum       = %s"sums" sep (posted-bare ws name-not-in / posted-account sep name)
                    sep scope-and-window

scope-and-window  = (scope-w sep / scope-p ws) %s"over" sep window

scope-w           = %s"per" sep (%s"party" / %s"role" sep name / %s"rail" sep name
                    / per-counterparty ws %s"within" sep %s"each" sep %s"mandate" sep %s"root")
                  / %s"global"
scope-p           = %s"per" sep per-counterparty
per-counterparty  = %s"counterparty" ws "(" ws name ws ")"

window            = (%s"rolling" / %s"calendar") sep int-literal / %s"unbounded"

; --- rules -------------------------------------------------------------------

rule-decl         = %s"rule" sep name ws "{" ws (free-rule / obligated-rule) ws "}"
free-rule         = (%s"permitted" / %s"forbidden") sep actor ws %s"do" sep rule-action
                    clauses-p
obligated-rule    = %s"obligated" sep actor ws %s"do" sep rule-action clauses-pcf
rule-action       = action-term-w sep / action-term-p ws

actor             = (%s"any_in_role" / %s"specific") ws "(" ws name ws ")"

action-term-w     = name
action-term-p     = name ws "{" ws [binding *(ws "," ws binding) ws] "}"
binding           = name ws ":" ws value

; The clauses after the action come in any order. A rule has exactly one
; `priority`, and only an obligated rule may have `capture` and
; `performed_by`, each at most once. `unless` may be written any number of
; times, and each one counts. `trigger`, `when`, `on_violation` and the
; temporal clause come at most once each, a count left to prose above:
; stating it here would take sixteen times the states below.
;
; Each clauses-* rule is the rest of the list in one state. Its letters say
; what may still come: p, a `priority` is still owed; c, a `capture` may still
; come; f, a `performed_by` may still come.
clauses-pcf       = clause-run ( priority-clause [sep clauses-cf]
                               / capture-clause ws clauses-pf
                               / performer-w sep clauses-pc / performer-p ws clauses-pc )
clauses-pc        = clause-run ( priority-clause [sep clauses-c] / capture-clause ws clauses-p )
clauses-pf        = clause-run ( priority-clause [sep clauses-f]
                               / performer-w sep clauses-p / performer-p ws clauses-p )
clauses-p         = clause-run priority-clause [sep clauses-end]
clauses-cf        = clauses-end
                  / clause-run ( capture-clause ws clauses-f
                               / performer-w [sep clauses-c] / performer-p ws clauses-c )
clauses-c         = clauses-end / clause-run capture-clause ws clauses-end
clauses-f         = clauses-end
                  / clause-run ( performer-w [sep clauses-end] / performer-p ws clauses-end )
clauses-end       = clause-run [clause-w]
; Each of `trigger`, `when`, `on_violation` and the temporal clause comes at
; most once per rule; that count is prose (see above), so this run allows
; repeats.
clause-run        = *(clause-w sep / clause-p ws)

clause-w          = trigger-w / on-violation-clause
clause-p          = trigger-p / when-clause / temporal-clause / unless-clause

trigger-w         = %s"trigger" sep action-term-w
trigger-p         = %s"trigger" sep action-term-p
when-clause       = %s"when" ws condition
temporal-clause   = (%s"within" / %s"by") ws "(" ws int-literal ws ")"
                  / %s"during" ws "(" ws int-literal ws "," ws int-literal ws ")"
unless-clause     = %s"unless" sep name ws condition
on-violation-clause = %s"on_violation" sep name
priority-clause   = %s"priority" (sep int-literal / ws "-" ws int-literal)

capture-clause    = %s"capture" ws "{" ws [capture *(ws "," ws capture) [ws ","] ws] "}"
capture           = name ws ":" ws (%s"trigger_transaction"
                                   / %s"trigger_param" ws "(" ws name ws ")")
performer-w       = %s"performed_by" sep %s"debtor"
performer-p       = %s"performed_by" sep (%s"trigger_party" / %s"specific") ws "(" ws name ws ")"

; --- conditions --------------------------------------------------------------

; A condition is a conjunction of disjunctions; either may be empty.
condition         = "{" ws [disjunction *(ws %s"and" ws disjunction) ws] "}"
disjunction       = "(" ws [*(literal-w sep %s"or" sep / literal-p ws %s"or" sep) literal ws] ")"
literal           = literal-w / literal-p

literal-w         = [%s"not" sep] ( in-left %s"in" sep (reference-set / subject-w)
                                  / relation-left relation ws subject-w )
literal-p         = [%s"not" sep] ( in-left %s"in" sep subject-p
                                  / relation-left relation ws subject-p )
; A posting selector with no account cannot stand before `in`: it would take
; `in` as the start of its account.
in-left           = subject-w sep / closed-subject ws
relation-left     = (subject-w / subject-p) ws
relation          = "==" / "!=" / "<=" / ">=" / "<" / ">"

reference-set     = %s"approved" sep %s"counterparties"
                  / %s"chart" sep %s"of" sep %s"accounts"
                  / %s"open" sep %s"fiscal" sep %s"periods"

subject-w         = %s"actor" / %s"now" / posted-account
subject-p         = closed-subject / posted-bare
closed-subject    = param-term / mandate-term / projected-term / register-term
                  / counterparty-term / value

param-term        = %s"param" ws "(" ws name ws ")"
mandate-term      = (%s"spent" / %s"ceiling" / %s"remaining") ws "(" ws name ws ")"
; `projected(register(...))` reads a register, so a mandate named `register`
; cannot be projected.
projected-term    = %s"projected" ws "(" ws
                    (%s"register" ws "(" ws name ws ")" / name-not-register) ws ")"
register-term     = %s"register" ws "(" ws name ws ")"
counterparty-term = (%s"counterparty" sep %s"limit" / %s"resolved" sep %s"counterparty")
                    ws "(" ws name ws ")"

; A posting selector: an omitted side is debit.
posted-bare       = %s"posted" [sep posting-side] ws currency
posted-account    = posted-bare ws %s"in" sep account-id
posting-side      = %s"debit" / %s"credit"

; --- values ------------------------------------------------------------------

value             = %s"bool" ws "(" ws (%s"true" / %s"false") ws ")"
                  / %s"int" ws "(" ws signed-int ws ")"
                  / %s"amount" ws "(" ws signed-int ws "," ws currency ws ")"
                  / %s"text" ws "(" ws string ws ")"
                  / (%s"party" / %s"role" / %s"action") ws "(" ws name ws ")"
                  / %s"tick" ws "(" ws int-literal ws ")"
                  / %s"transaction" ws "(" ws transaction-id ws ")"

value-type        = %s"bool" / %s"int" / %s"amount" / %s"text" / %s"party" / %s"role"
                  / %s"tick" / %s"action" / %s"transaction"

signed-int        = ["-" ws] int-literal

; --- words -------------------------------------------------------------------

; A name. Keywords are names too, except in the two places below.
name              = 1*64name-char
name-char         = %x61-7A / %x30-39 / "_"

; Every name but `in`, and every name but `register`, for the two places the
; parser reads that word as a keyword.
name-not-in       = %s"i" [name-char-not-n *62name-char]
                  / %s"in" 1*62name-char
                  / name-char-not-i *63name-char
name-not-register = name-char-not-r *63name-char
                  / %s"r" [name-char-not-e *62name-char]
                  / %s"re" [name-char-not-g *61name-char]
                  / %s"reg" [name-char-not-i *60name-char]
                  / %s"regi" [name-char-not-s *59name-char]
                  / %s"regis" [name-char-not-t *58name-char]
                  / %s"regist" [name-char-not-e *57name-char]
                  / %s"registe" [name-char-not-r *56name-char]
                  / %s"register" 1*56name-char
name-char-not-e   = %x30-39 / "_" / %x61-64 / %x66-7A
name-char-not-g   = %x30-39 / "_" / %x61-66 / %x68-7A
name-char-not-i   = %x30-39 / "_" / %x61-68 / %x6A-7A
name-char-not-n   = %x30-39 / "_" / %x61-6D / %x6F-7A
name-char-not-r   = %x30-39 / "_" / %x61-71 / %x73-7A
name-char-not-s   = %x30-39 / "_" / %x61-72 / %x74-7A
name-char-not-t   = %x30-39 / "_" / %x61-73 / %x75-7A

; Decimal digits, optionally grouped with underscores.
int-literal       = *"_" decimal *(decimal / "_")
decimal           = %x30-39

; A client-minted id: a prefix, then a 128-bit value as 26 lowercase
; Crockford base32 characters, the first of them 0-7.
account-id        = %s"acc_" id-suffix
transaction-id    = %s"txn_" id-suffix
id-suffix         = %x30-37 25base32-char
base32-char       = %x30-39 / %x61-68 / %x6A-6B / %x6D-6E / %x70-74 / %x76-7A

; --- currency codes and strings ------------------------------------------------

; Three to eight uppercase letters, e.g. USD or USDC.
currency          = 3*8capital
capital           = %x41-5A

; A string is one line: any character but a double quote, a backslash or a
; line feed, and the escapes \" \\ \n \t \r.
string            = %x22 *string-char %x22
string-char       = %x00-09 / %x0B-21 / %x23-5B / %x5D-D7FF / %xE000-10FFFF / escape
escape            = %x5C (%x22 / %x5C / %s"n" / %s"t" / %s"r")

; --- whitespace and comments ---------------------------------------------------

ws                = *(blank / comment)
sep               = 1*(blank / comment)
blank             = %x20 / %x09 / %x0D / %x0A
; A comment runs to the end of its line, so only the last line of a source can
; hold a comment with no line feed after it.
comment           = "//" *comment-char %x0A
end-comment       = "//" *comment-char
comment-char      = %x00-09 / %x0B-D7FF / %xE000-10FFFF
